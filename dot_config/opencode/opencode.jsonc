{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "external_directory", "resource": "~/go/pkg/mod/*", "effect": "allow" },
    { "action": "read", "resource": "~/go/pkg/mod/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.agent/*", "effect": "allow" },
    { "action": "read", "resource": "~/.agent/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.agents/*", "effect": "allow" },
    { "action": "read", "resource": "~/.agents/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.opensrc/*", "effect": "allow" },
    { "action": "read", "resource": "~/.opensrc/*", "effect": "allow" },

    { "action": "read", "resource": "mise.*.toml", "effect": "deny" },
    { "action": "read", "resource": "*/mise.*.toml", "effect": "deny" },
  ],
  "plugin": ["@plannotator/opencode@latest"],
  "mcp": {
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/v1/mcp",
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
    },
  },
}
